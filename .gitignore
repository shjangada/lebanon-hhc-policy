.DS_Store
__pycache__/
*.pyc
.venv/
.env
.pytest_cache/
*.egg-info/
# raw downloads are committed (small) except files >5 MB, which scripts/fetch_sources.py re-downloads
data/raw/admin_boundaries/*.geojson.zip
data/raw/soil_sites/**/*.pdf
data/processed/*
!data/processed/.gitkeep
.ipynb_checkpoints/
outputs/figures/*.png

# --- ingest rules ---
.claude/
# ACLED terms forbid redistributing raw data: keep ACLED files and ACLED-derived processed counts out of git
data/raw/conflict_events/acled/
data/raw/conflict_events/hdx/acled_*
data/processed/conflict_events*.csv
# >5 MB raw files are re-downloadable (scripts/fetch_sources.py) or manual
data/raw/lhf/global_cbpf_project_summary.csv
data/raw/unhabitat_rma/*.pdf
data/raw/msna/*.pdf
# real processed datasets are committed (pipeline outputs m1_/m2_/... stay ignored)
!data/processed/cadasters.csv
!data/processed/cadasters.geojson
!data/processed/cadasters_national.csv
!data/processed/population.csv
!data/processed/facilities.csv
